; Micro Garden's Godot viewer. It draws what the garden publishes (viewer/snapshot.py) and owns no state.
config_version=5

[application]
config/name="Micro Garden"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
; the panels and the menu grow with the window, as laid out for 1280 x 800; the garden renders at full size
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
environment/defaults/default_clear_color=Color(0.957, 0.918, 0.835, 1)
anti_aliasing/quality/msaa_3d=2

[shader_globals]
sun_dir={
"type": "vec3",
"value": Vector3(0.4, 0.8, 0.3)
}
daylight={
"type": "float",
"value": 1.0
}
screen={
"type": "float",
"value": 1.0
}
